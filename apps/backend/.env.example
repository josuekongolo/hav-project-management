DATABASE_URL="postgresql://user:password@localhost:5432/hav_pm"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Resend API Configuration (Primary - for havdis.no domain)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="your-resend-api-key-here"
SMTP_FROM="noreply@havdis.no"

# Domeneshop SMTP Configuration (Fallback - only used if RESEND_API_KEY is not set)
SMTP_HOST="smtp.domeneshop.no"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@yourdomain.no"
SMTP_PASSWORD="your-email-password"
