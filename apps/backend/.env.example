DATABASE_URL="postgresql://user:password@localhost:5432/hav_pm"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Resend API Configuration (Required)
# Get your API key from: https://resend.com/api-keys
# SMTP_FROM must be a verified domain in your Resend account
RESEND_API_KEY="your-resend-api-key-here"
SMTP_FROM="your-email@your-verified-domain.com"

# Google Drive API Configuration
# Follow setup guide: https://developers.google.com/drive/api/quickstart/nodejs
GOOGLE_API_KEY="your-google-api-key"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/google/callback"
GOOGLE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-folder-id"
