generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  avatar    String?
  role      UserRole   @default(MEMBER)
  bio       String?
  status    UserStatus @default(AVAILABLE)
  timezone  String     @default("UTC")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  assignedTasks TaskAssignee[]
  createdTasks  Task[]         @relation("CreatedTasks")
  comments      Comment[]
  timeLogs      TimeLog[]
  notifications Notification[]

  @@map("users")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum UserStatus {
  AVAILABLE
  BUSY
  AWAY
  OFFLINE
}

model Task {
  id              String       @id @default(uuid())
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  position        Int
  estimatedHours  Float?

  assignees TaskAssignee[]

  creatorId String
  creator   User   @relation("CreatedTasks", fields: [creatorId], references: [id])

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])

  labels   TaskLabel[]
  comments Comment[]
  timeLogs TimeLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  dueDate   DateTime?

  @@index([status])
  @@index([milestoneId])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Milestone {
  id          String          @id @default(uuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      MilestoneStatus @default(ACTIVE)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("milestones")
}

enum MilestoneStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Label {
  id    String @id @default(uuid())
  name  String @unique
  color String

  tasks TaskLabel[]

  createdAt DateTime @default(now())

  @@map("labels")
}

model TaskLabel {
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model TaskAssignee {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
  @@index([taskId])
  @@map("task_assignees")
}

model Comment {
  id      String @id @default(uuid())
  content String

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

model TimeLog {
  id          String   @id @default(uuid())
  hours       Float
  description String?
  loggedAt    DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
  @@map("time_logs")
}

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType
  title   String
  message String
  link    String?
  read    Boolean          @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENT
  TASK_MENTION
  TASK_DUE_SOON
  TASK_COMPLETED
  MILESTONE_DUE_SOON
}
